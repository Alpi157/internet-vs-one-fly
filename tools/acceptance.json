{
  "schema_version": 1,
  "milestones": {
    "M01": {
      "title": "Repository, tooling, invariants and review harness",
      "commands": [
        {
          "name": "locked-development-environment",
          "argv": ["uv", "sync", "--extra", "dev", "--locked"],
          "cwd": ".",
          "required": true,
          "required_paths": ["pyproject.toml", "uv.lock"],
          "timeout_seconds": 180
        },
        {
          "name": "architecture-identity",
          "argv": [
            "python",
            "-c",
            "import hashlib,pathlib,sys; p=pathlib.Path('docs/architecture.md'); h=hashlib.sha256(p.read_bytes()).hexdigest(); print(h); sys.exit(h != 'bae80837d5d6d769ae5b728af3b80c1caa21b7f08efdd7f3eb458f7bb2eab9d1')"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": ["docs/architecture.md"],
          "timeout_seconds": 30
        },
        {
          "name": "m01-offline-tests",
          "argv": [
            "python",
            "-m",
            "pytest",
            "-q",
            "tests/test_scaffold.py",
            "tests/test_review_tools.py"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": ["tests/test_scaffold.py", "tests/test_review_tools.py"],
          "timeout_seconds": 180
        },
        {
          "name": "clean-committed-code-identity",
          "argv": [
            "python",
            "-c",
            "import subprocess,sys; head=subprocess.run(['git','rev-parse','HEAD'],capture_output=True,text=True); status=subprocess.run(['git','status','--porcelain=v1','--untracked-files=all'],capture_output=True,text=True); print(head.stdout.strip()); print(status.stdout,end=''); sys.stderr.write(head.stderr+status.stderr); sys.exit(head.returncode or status.returncode or bool(status.stdout))"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": [".git"],
          "timeout_seconds": 30
        }
      ]
    },
    "M02": {
      "title": "Pinned official source acquisition",
      "commands": [
        {
          "name": "resolved-source-fetch-reuse",
          "argv": [
            "flybench",
            "data",
            "fetch",
            "--lock",
            "profiles/source-lock.json",
            "--out",
            "data/raw"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": [
            "profiles/source-lock.json",
            "data/raw/body-annotations-male-cns-v1.0-minconf-0.5.feather",
            "data/raw/body-neurotransmitters-male-cns-v1.0.feather",
            "data/raw/connectome-weights-male-cns-v1.0-minconf-0.5.feather"
          ],
          "timeout_seconds": 600
        },
        {
          "name": "m02-offline-source-tests",
          "argv": ["python", "-m", "pytest", "-q", "tests/test_source_fetch.py"],
          "cwd": ".",
          "required": true,
          "required_paths": ["tests/test_source_fetch.py"],
          "timeout_seconds": 180
        },
        {
          "name": "independent-source-sha256",
          "argv": [
            "sha256sum",
            "data/raw/body-annotations-male-cns-v1.0-minconf-0.5.feather",
            "data/raw/body-neurotransmitters-male-cns-v1.0.feather",
            "data/raw/connectome-weights-male-cns-v1.0-minconf-0.5.feather"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": [
            "data/raw/body-annotations-male-cns-v1.0-minconf-0.5.feather",
            "data/raw/body-neurotransmitters-male-cns-v1.0.feather",
            "data/raw/connectome-weights-male-cns-v1.0-minconf-0.5.feather"
          ],
          "timeout_seconds": 600
        },
        {
          "name": "architecture-identity",
          "argv": [
            "python",
            "-c",
            "import hashlib,pathlib,sys; p=pathlib.Path('docs/architecture.md'); h=hashlib.sha256(p.read_bytes()).hexdigest(); print(h); sys.exit(h != 'bae80837d5d6d769ae5b728af3b80c1caa21b7f08efdd7f3eb458f7bb2eab9d1')"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": ["docs/architecture.md"],
          "timeout_seconds": 30
        },
        {
          "name": "clean-committed-code-identity",
          "argv": [
            "python",
            "-c",
            "import subprocess,sys; head=subprocess.run(['git','rev-parse','HEAD'],capture_output=True,text=True); status=subprocess.run(['git','status','--porcelain=v1','--untracked-files=all'],capture_output=True,text=True); print(head.stdout.strip()); print(status.stdout,end=''); sys.stderr.write(head.stderr+status.stderr); sys.exit(head.returncode or status.returncode or bool(status.stdout))"
          ],
          "cwd": ".",
          "required": true,
          "required_paths": [".git"],
          "timeout_seconds": 30
        }
      ]
    }
  }
}
