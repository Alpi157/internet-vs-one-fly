            "import hashlib,json,pathlib,sys; r=pathlib.Path('.'); e=r/'evidence/M04'; m=json.loads((e/'mapping.json').read_text()); d=json.loads((e/'decision.json').read_text()); a=json.loads((e/'circuit-audit.json').read_text()); c=json.loads((e/'cut-context.json').read_text()); profiles={x['kind']:x for x in m['candidate_profile_identities']}; paths={'model':'profiles/model-v0.1.json','encoder':'profiles/encoder-v0.1.json','decoder':'profiles/decoder-v0.1.json','calibration_plan':'profiles/calibration-plan.json'}; ok=m['status']=='PASS' and m['producer']['code_git_sha']==__import__('subprocess').check_output(['git','rev-parse','HEAD'],text=True).strip() and m['circuit_profile_validation']['status']=='PASS' and m['compiled_circuit_verification']['status']=='PASS' and d['outcome']=='PASS' and d['allowed_next_milestone']=='M05' and d['manual_mapping_review_receipt']['status']=='PRESENT_OPERATOR_SUPPLIED' and a['status']=='PASS' and a['semantic_graph_digest']==m['compiled_circuit_verification']['semantic_graph_digest'] and a['graph']['source_accepted_E']==c['internal']['pair_edges'] and a['graph']['represented_source_contacts']==c['internal']['contact_mass'] and all(hashlib.sha256((r/p).read_bytes()).hexdigest()==profiles[k]['sha256'] for k,p in paths.items()); print(json.dumps({'status':'PASS' if ok else 'FAIL','mapping':m['mapping_digest']['value'],'circuit':a['semantic_graph_digest']},sort_keys=True)); sys.exit(not ok)"
