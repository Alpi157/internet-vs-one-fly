          "argv": [
            "python",
            "-c",
            "import hashlib,json,pathlib,subprocess,sys; e=pathlib.Path('evidence/M04'); names=['mapping.json','mapping-review.txt','annotation-excerpts.json','pathway-connectivity.json','sign-coverage.json','cut-context.json','calibration-plan.json','decision.json']; digest=lambda p: hashlib.sha256(p.read_bytes()).hexdigest(); before={n:digest(e/n) for n in names}; cmd=[sys.executable,'tools/build_m04_mapping.py','--lock','profiles/source-lock.json','--full-graph','data/compiled/full','--circuit-profile','profiles/escape-circuit.json','--circuit-graph','data/compiled/escape','--out','evidence/M04','--require-manual-review']; run=subprocess.run(cmd,capture_output=True,text=True); after={n:digest(e/n) for n in names}; stable=run.returncode==0 and before==after; report={'schema_version':1,'status':'PASS' if stable else 'FAIL','command':cmd,'before_sha256':before,'after_sha256':after,'mapping_semantic_sha256':json.loads((e/'mapping.json').read_text())['mapping_digest']['value']}; (e/'mapping-determinism.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\n'); print(json.dumps(report,sort_keys=True)); sys.stderr.write(run.stderr); sys.exit(not stable)"
          ],
          "cwd": ".",
          "required": true,
